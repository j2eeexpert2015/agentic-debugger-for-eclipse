Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Agentic Debugger for Eclipse IDE
Bundle-SymbolicName: org.learningfromexperience.eclipse.agentdebug;singleton:=true
Bundle-Version: 1.5.0.qualifier
Bundle-Activator: org.learningfromexperience.eclipse.agentdebug.Activator
Bundle-Vendor: Ayan Dutta
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.ui;bundle-version="3.207.400",
 org.eclipse.debug.core;bundle-version="3.23.200",
 org.eclipse.jdt.debug;bundle-version="3.25.0",
 org.eclipse.core.resources,
 org.eclipse.jdt.core,
 org.eclipse.jdt.launching,
 org.eclipse.debug.ui,
 org.eclipse.ui.console,
 org.eclipse.text,
 org.eclipse.m2e.core;resolution:=optional,
 org.eclipse.jdt.junit.core;resolution:=optional,
 org.eclipse.ui.ide,
 org.eclipse.e4.ui.model.workbench,
 org.eclipse.e4.ui.workbench,
 org.eclipse.e4.core.contexts
Import-Package: com.microsoft.copilot.eclipse.ui.extensions;resolution:=optional
Bundle-RequiredExecutionEnvironment: JavaSE-21
Automatic-Module-Name: org.learningfromexperience.eclipse.agentdebug
Bundle-ActivationPolicy: lazy
Bundle-ClassPath: .,
 lib/report.jar
