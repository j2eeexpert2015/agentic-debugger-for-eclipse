Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Agentic Debugger for Eclipse IDE
Bundle-SymbolicName: org.learningfromexperience.eclipse.agentdebug;singleton:=true
Bundle-Version: 1.1.0.qualifier
Bundle-Activator: org.learningfromexperience.eclipse.agentdebug.Activator
Bundle-Vendor: Ayan Dutta
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.ui;bundle-version="3.209.100",
 org.eclipse.debug.core;bundle-version="3.24.0",
 org.eclipse.jdt.debug;bundle-version="3.26.100",
 org.eclipse.core.resources,
 org.eclipse.jdt.core
Bundle-RequiredExecutionEnvironment: JavaSE-21
Automatic-Module-Name: org.learningfromexperience.eclipse.agentdebug
Bundle-ActivationPolicy: lazy
