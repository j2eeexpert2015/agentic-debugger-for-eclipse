<?xml version="1.0" encoding="UTF-8"?>
<classpath>
    <classpathentry kind="src" path="src"/>
    <!-- Unit tests (JUnit 5): compiled and run by Maven/Tycho (maven-surefire-plugin), never packaged in the bundle -->
    <classpathentry kind="src" output="bin_test" path="tests">
        <attributes>
            <attribute name="test" value="true"/>
        </attributes>
    </classpathentry>
    <classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-25"/>
    <classpathentry kind="con" path="org.eclipse.pde.core.requiredPlugins"/>
    <!-- OPEN-36, OPEN-38 step 4: the report module (Agent Activity page and store), copied here by "mvn clean package" (Bundle-ClassPath in MANIFEST.MF) -->
    <classpathentry kind="lib" path="lib/report.jar"/>
    <classpathentry kind="con" path="org.eclipse.jdt.junit.JUNIT_CONTAINER/5"/>
    <classpathentry kind="output" path="bin"/>
</classpath>
