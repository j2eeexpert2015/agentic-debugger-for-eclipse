<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.learningfromexperience</groupId>
        <artifactId>agentic-debugger-distribution</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>org.learningfromexperience.eclipse.agentdebug</artifactId>
    <version>1.5.0-SNAPSHOT</version>
    <packaging>eclipse-plugin</packaging>
    <name>Agentic Debugger for Eclipse IDE Plugin</name>
    <build>
      <plugins>

        <!-- Unit tests (folder "tests", declared as a test source folder in .classpath), JUnit 5.
             Tycho's documented way for plain unit tests in an eclipse-plugin module: maven-surefire-plugin
             with an explicit JUnit Platform provider (https://tycho.eclipseprojects.io/doc/master/TestingBundles.html,
             demo "surefire/with-source-folder"). Only tests that need no running Eclipse belong here; tests
             against a live Eclipse run through dev-e2e/DevE2E.java. Test classes never go into the bundle. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.4</version>
          <executions>
            <execution>
              <id>execute-tests</id>
              <goals><goal>test</goal></goals>
            </execution>
          </executions>
          <dependencies>
            <dependency>
              <groupId>org.apache.maven.surefire</groupId>
              <artifactId>surefire-junit-platform</artifactId>
              <version>3.5.4</version>
            </dependency>
          </dependencies>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-antrun-plugin</artifactId>
          <version>3.1.0</version>
          <executions>
            <execution>
              <id>normalize-bundled-jar-name</id>
              <phase>generate-resources</phase>
              <goals><goal>run</goal></goals>
              <configuration><target>
                <mkdir dir="${project.basedir}/lib"/>
                <copy file="${project.basedir}/../mcp-server/target/agentic-debugger-mcp-1.0.0-SNAPSHOT.jar"
                      tofile="${project.basedir}/lib/agentic-debugger-mcp.jar" overwrite="true"/>
              </target></configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </build>
</project>
