<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.ui.startup">
      <startup class="org.learningfromexperience.eclipse.agentdebug.AgentDebugStartup"/>
   </extension>
   <!-- OPEN-23: offers the eclipse-debugger MCP server to GitHub Copilot for Eclipse; Copilot asks the user once.
        Without Copilot installed this extension point does not exist and the entry is ignored. -->
   <extension point="com.microsoft.copilot.eclipse.ui.mcpRegistration">
      <provider
          id="org.learningfromexperience.eclipse.agentdebug.copilotMcp"
          class="org.learningfromexperience.eclipse.agentdebug.integration.CopilotMcpProvider"/>
   </extension>
   <extension point="org.eclipse.ui.preferencePages">
      <page
          id="org.learningfromexperience.eclipse.agentdebug.preferences"
          name="Agentic Debugger"
          class="org.learningfromexperience.eclipse.agentdebug.ui.ClaudeIntegrationPreferences"/>
   </extension>
   <!-- OPEN-36: Agent Activity view, under its own category in Window > Show View > Other... -->
   <extension point="org.eclipse.ui.views">
      <category
          id="org.learningfromexperience.eclipse.agentdebug.viewCategory"
          name="Agentic Debugger"/>
      <view
          id="org.learningfromexperience.eclipse.agentdebug.activityView"
          name="Agent Activity"
          category="org.learningfromexperience.eclipse.agentdebug.viewCategory"
          class="org.learningfromexperience.eclipse.agentdebug.ui.AgentActivityView"
          restorable="true"/>
   </extension>
   <!-- OPEN-36: agent status in the status bar ("Agent: running · 12 s"); a click opens Agent Activity -->
   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="toolbar:org.eclipse.ui.trim.status">
         <toolbar id="org.learningfromexperience.eclipse.agentdebug.statusToolbar">
            <control
                id="org.learningfromexperience.eclipse.agentdebug.agentStatus"
                class="org.learningfromexperience.eclipse.agentdebug.ui.AgentStatusControl"/>
         </toolbar>
      </menuContribution>
   </extension>
   <!-- OPEN-36: the Agent Activity view's own area, to the right of the Console: not stacked with the Console (which
        comes to the front whenever the program prints) nor with Variables (front at each stop). Applies to a new or
        reset perspective (Window > Perspective > Reset Perspective...). -->
   <extension point="org.eclipse.ui.perspectiveExtensions">
      <perspectiveExtension targetID="org.eclipse.jdt.ui.JavaPerspective">
         <view id="org.learningfromexperience.eclipse.agentdebug.activityView" relative="org.eclipse.ui.console.ConsoleView"
               relationship="right" ratio="0.45" visible="false"/>
      </perspectiveExtension>
      <perspectiveExtension targetID="org.eclipse.debug.ui.DebugPerspective">
         <view id="org.learningfromexperience.eclipse.agentdebug.activityView" relative="org.eclipse.ui.console.ConsoleView"
               relationship="right" ratio="0.45" visible="false"/>
      </perspectiveExtension>
   </extension>
   <!-- OPEN-35: where the debug views go when an agent session opens them in the Java perspective: their own group
        under the editor, never the group of the terminal that runs Claude. Placeholders only (visible="false"): the
        Java perspective looks unchanged until debugging starts. Applies to a new or reset Java perspective. -->
   <extension point="org.eclipse.ui.perspectiveExtensions">
      <perspectiveExtension targetID="org.eclipse.jdt.ui.JavaPerspective">
         <view id="org.eclipse.debug.ui.VariableView" relative="org.eclipse.ui.editorss" relationship="bottom"
               ratio="0.62" visible="false"/>
         <view id="org.eclipse.debug.ui.BreakpointView" relative="org.eclipse.debug.ui.VariableView"
               relationship="stack" visible="false"/>
         <view id="org.eclipse.debug.ui.ExpressionView" relative="org.eclipse.debug.ui.VariableView"
               relationship="stack" visible="false"/>
         <view id="org.eclipse.debug.ui.DebugView" relative="org.eclipse.debug.ui.VariableView"
               relationship="stack" visible="false"/>
      </perspectiveExtension>
   </extension>
   <!-- OPEN-36: when Eclipse switches to the Debug perspective for an agent investigation, the open terminal views
        (the Claude terminal) are shown there too (TerminalCarrier). Their place: below the Debug view, where neither the
        Console nor Variables covers them. Placeholders only (visible="false"); the ":*" forms cover a second Terminal
        view. IDs: Eclipse Platform Terminal (2025-09 and later) and the earlier CDT/TM Terminal. Applies to a new or
        reset Debug perspective; in an existing one TerminalCarrier moves a covered terminal once. -->
   <extension point="org.eclipse.ui.perspectiveExtensions">
      <perspectiveExtension targetID="org.eclipse.debug.ui.DebugPerspective">
         <view id="org.eclipse.terminal.view.ui.TerminalsView" relative="org.eclipse.debug.ui.DebugView"
               relationship="bottom" ratio="0.5" visible="false"/>
         <view id="org.eclipse.terminal.view.ui.TerminalsView:*" relative="org.eclipse.terminal.view.ui.TerminalsView"
               relationship="stack" visible="false"/>
         <view id="org.eclipse.tm.terminal.view.ui.TerminalsView" relative="org.eclipse.terminal.view.ui.TerminalsView"
               relationship="stack" visible="false"/>
         <view id="org.eclipse.tm.terminal.view.ui.TerminalsView:*" relative="org.eclipse.terminal.view.ui.TerminalsView"
               relationship="stack" visible="false"/>
      </perspectiveExtension>
   </extension>
</plugin>
