<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
      Test tooling, not shipped with the plugin:
        - the Claude transcript grader (EVAL-05/06), package testing.grading; its unit tests (EV-U1..EV-U18) run in the
          normal build ("mvn clean package");
        - the direct bridge verifiers, package e2e (moved here from the e2e-runner module, OPEN-38 step 6): Maven only
          compiles them, so a broken verifier fails the build; dev-e2e/DevE2E.java compiles and runs them against a live
          Eclipse;
        - ownership-tests/: the 32-check ownership harness (OPEN-03), built and started by its own run.ps1.
      Integration tests against a live Eclipse and Claude trials are NOT run by Maven; they run only through
      dev-e2e/DevE2E.java.
    -->
    <groupId>org.learningfromexperience</groupId>
    <artifactId>agentic-debugger-testing</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Agentic Debugger for Eclipse IDE Test Tooling</name>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.14.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>
        </plugins>
    </build>
</project>
