<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
      Test tooling, not shipped with the plugin:
        - src/main/java: the Claude transcript grader (testing.grading, EVAL-05/06) and the Claude trial runner
          (testing.trial); the grader's unit tests (EV-U1..EV-U19, src/test/java/.../grading) run in the normal build;
        - src/test/java/.../e2e: the integration tests as JUnit 5 classes, one per product feature, and the Claude
          end-to-end tests. They need the running test Eclipse, so the normal build only compiles them (a broken test
          fails the build) and never runs them. They run with the profile below:
              mvn -pl testing verify -Pintegration-tests                         (regression suite)
              mvn -pl testing verify -Pintegration-tests -Dit.test=FullSuite     (or ExtendedSuite, BreakpointTests, ...)
          See docs/integration-tests.md;
        - The former 32-check ownership harness (ownership-tests/, PowerShell) was deleted on 25 Nov 2026; its checks
          run as the JUnit class UserResourceSafetyTests (OPEN-02/03).
    -->
    <groupId>org.learningfromexperience</groupId>
    <artifactId>agentic-debugger-testing</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Agentic Debugger for Eclipse IDE Test Tooling</name>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.14.1</version>
            <scope>test</scope>
        </dependency>
        <!-- @Suite classes (RegressionSuite, ExtendedSuite, FullSuite) of the integration tests -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <version>1.14.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <!-- Unit tests only: the integration tests (package e2e) need the test Eclipse. -->
                    <excludes>
                        <exclude>**/e2e/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- What to test (-Drun=..., root pom.xml). The grader's unit tests are skipped unless the name asks for them. -->
        <profile>
            <id>run-set</id>
            <activation><property><name>run</name></property></activation>
            <properties><skipTests>true</skipTests></properties>
        </profile>
        <profile>
            <id>run-claude-grader-unit-tests-without-eclipse</id>
            <activation><property><name>run</name><value>claude-grader-unit-tests-without-eclipse</value></property></activation>
            <properties><skipTests>false</skipTests></properties>
        </profile>
        <profile>
            <id>run-all-unit-tests</id>
            <activation><property><name>run</name><value>all-unit-tests-without-eclipse</value></property></activation>
            <properties><skipTests>false</skipTests></properties>
        </profile>
        <!-- Debugger tests: close the test Eclipse, install the build just made, start it, run the RegressionSuite (-Dit.test=FullSuite, a class or Class#method for others) -->
        <profile>
            <id>run-eclipse-plugin-debugger-tests-with-test-eclipse</id>
            <activation><property><name>run</name><value>eclipse-plugin-debugger-tests-with-test-eclipse</value></property></activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>close-test-eclipse</id>
                                <phase>pre-integration-test</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <workingDirectory>${project.basedir}/..</workingDirectory>
                                    <arguments>
                                        <argument>dev-e2e/TestSteps.java</argument>
                                        <argument>close-test-eclipse</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>install-and-start</id>
                                <phase>pre-integration-test</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <workingDirectory>${project.basedir}/..</workingDirectory>
                                    <arguments>
                                        <argument>dev-e2e/DevE2E.java</argument>
                                        <argument>deploy</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.5.4</version>
                        <configuration>
                            <!-- run-set skips the unit tests (skipTests=true); these tests run all the same -->
                            <skipTests>false</skipTests>
                            <includes>
                                <include>**/e2e/RegressionSuite.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <fixture.post.approved>true</fixture.post.approved>
                            </systemPropertyVariables>
                            <trimStackTrace>false</trimStackTrace>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Install tests: close the test Eclipse, install the built update-site zip, uninstall it, reinstall it, start Eclipse, run the RegressionSuite -->
        <profile>
            <id>run-eclipse-plugin-install-tests-with-test-eclipse</id>
            <activation><property><name>run</name><value>eclipse-plugin-install-tests-with-test-eclipse</value></property></activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>close-test-eclipse</id>
                                <phase>pre-integration-test</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <workingDirectory>${project.basedir}/..</workingDirectory>
                                    <arguments>
                                        <argument>dev-e2e/TestSteps.java</argument>
                                        <argument>close-test-eclipse</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>zip-install-uninstall-reinstall</id>
                                <phase>pre-integration-test</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <workingDirectory>${project.basedir}/..</workingDirectory>
                                    <arguments>
                                        <argument>dev-e2e/TestSteps.java</argument>
                                        <argument>zip-lifecycle</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>start</id>
                                <phase>pre-integration-test</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <workingDirectory>${project.basedir}/..</workingDirectory>
                                    <arguments>
                                        <argument>dev-e2e/DevE2E.java</argument>
                                        <argument>start</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.5.4</version>
                        <configuration>
                            <!-- run-set skips the unit tests (skipTests=true); these tests run all the same -->
                            <skipTests>false</skipTests>
                            <includes>
                                <include>**/e2e/RegressionSuite.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <fixture.post.approved>true</fixture.post.approved>
                            </systemPropertyVariables>
                            <trimStackTrace>false</trimStackTrace>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Claude agent trial (uses Claude usage; the name is the consent): close, install, start, then real Claude Code debugs the planted Spring Boot quote bug (-Dit.test=ClaudeAgentEndToEndTests#junitWrongDiscount or #springBootValidation400 for the others) -->
        <profile>
            <id>run-claude-agent-trial-with-test-eclipse</id>
            <activation><property><name>run</name><value>claude-agent-trial-with-test-eclipse</value></property></activation>
            <!-- One trial by default; -Dit.test=... on the command line replaces it -->
            <properties><it.test>ClaudeAgentEndToEndTests#springBootWrongQuote</it.test></properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>close-test-eclipse</id>
                                <phase>pre-integration-test</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <workingDirectory>${project.basedir}/..</workingDirectory>
                                    <arguments>
                                        <argument>dev-e2e/TestSteps.java</argument>
                                        <argument>close-test-eclipse</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>install-and-start</id>
                                <phase>pre-integration-test</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <workingDirectory>${project.basedir}/..</workingDirectory>
                                    <arguments>
                                        <argument>dev-e2e/DevE2E.java</argument>
                                        <argument>deploy</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.5.4</version>
                        <configuration>
                            <!-- run-set skips the unit tests (skipTests=true); these tests run all the same -->
                            <skipTests>false</skipTests>
                            <includes>
                                <include>**/e2e/ClaudeAgentEndToEndTests.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <claude.approved>true</claude.approved>
                                <fixture.post.approved>true</fixture.post.approved>
                                <claude.report>true</claude.report>
                            </systemPropertyVariables>
                            <trimStackTrace>false</trimStackTrace>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
          The integration tests against the running test Eclipse (java dev-e2e/DevE2E.java start or deploy first).
          Default: the regression suite. -Dit.test=NAME runs another suite, one class or one test (Class#method).
          Options given with -D (fixture.post.approved, claude.approved, claude.model, claude.report, claude.skill,
          claude.batch, claude.repeat, claude.scenarios) reach
          the tests as system properties by themselves; unset means not approved / default.
        -->
        <profile>
            <id>integration-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.5.4</version>
                        <configuration>
                            <includes>
                                <include>**/e2e/RegressionSuite.java</include>
                            </includes>
                            <!-- Full stack traces in failures. The tests share one Eclipse: they run one after the other
                                 (JUnit's default); never configure parallel execution here. -->
                            <trimStackTrace>false</trimStackTrace>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
