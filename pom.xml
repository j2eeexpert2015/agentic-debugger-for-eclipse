<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.learningfromexperience</groupId>
    <artifactId>agentic-debugger-distribution</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Agentic Debugger for Eclipse IDE</name>
    <properties>
        <tycho.version>5.0.4</tycho.version>
        <agentdebug.phase1>false</agentdebug.phase1>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <modules>
        <!-- Debugging session report and Agent Activity page (OPEN-30, OPEN-36, ADR-009): events, isolation, the HTML
             writer and the page; no dependencies. Used by mcp-server and embedded in eclipse-plugin (lib/report.jar) -->
        <module>report</module>
        <module>mcp-server</module>
        <!-- Test tooling (Claude transcript grader) with its unit tests; not shipped -->
        <module>testing</module>
        <module>eclipse-plugin</module>
        <module>eclipse-feature</module>
        <module>eclipse-update-site</module>
    </modules>
    <profiles>
      <profile><id>e2e</id><modules><module>e2e-runner</module></modules></profile>
      <profile><id>phase1-bridge</id><modules><module>e2e-runner</module></modules><properties><agentdebug.phase1>true</agentdebug.phase1></properties></profile>
      <profile><id>installed-e2e</id><modules><module>e2e-runner</module></modules>
        <properties><agentdebug.test.installed>true</agentdebug.test.installed></properties>
      </profile>
    </profiles>
    <repositories>
        <repository>
            <id>eclipse-2026-09</id>
            <layout>p2</layout>
            <url>https://download.eclipse.org/releases/2026-09</url>
        </repository>
    </repositories>
    <build>
        <plugins>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-maven-plugin</artifactId>
                <version>${tycho.version}</version>
                <extensions>true</extensions>
            </plugin>
        </plugins>
    </build>
</project>
