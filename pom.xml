<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.learningfromexperience</groupId>
    <artifactId>agentic-debugger-distribution</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Agentic Debugger for Eclipse IDE</name>
    <properties>
        <tycho.version>5.0.4</tycho.version>
        <!-- OPEN-31: the Eclipse release the plugin is compiled against = the OLDEST supported release (2025-12), so
             every build proves the plugin uses no newer API; the same build runs on 2026-03, 2026-06 and 2026-09.
             MANIFEST.MF's minimum versions are this release's. When a new Eclipse is released, move both to the next
             oldest (for example 2026-03 after 2026-12). Override to try another: -Declipse.release=2026-09 -->
        <eclipse.release>2025-12</eclipse.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <modules>
        <!-- Debugging session report and Agent Activity page (OPEN-30, OPEN-36, ADR-009): events, isolation, the HTML
             writer and the page; no dependencies. Used by mcp-server and embedded in eclipse-plugin (lib/report.jar) -->
        <module>report</module>
        <module>mcp-server</module>
        <module>eclipse-plugin</module>
        <module>eclipse-feature</module>
        <module>eclipse-update-site</module>
        <!-- Test tooling, not shipped: the Claude transcript grader with its unit tests, the debugger tests (package
             e2e) and the Claude agent trials. Last on purpose (28 Nov): its test runs install the update site just
             built, so that must exist first. -->
        <module>testing</module>
    </modules>
    <repositories>
        <repository>
            <id>eclipse-release</id>
            <layout>p2</layout>
            <url>https://download.eclipse.org/releases/${eclipse.release}</url>
        </repository>
        <!-- OPEN-23: GitHub Copilot for Eclipse, only to compile against its MCP registration interface
             (com.microsoft.copilot.eclipse.ui.extensions, an optional import). Copilot is not part of our feature or
             update site. Official update site: https://github.com/microsoft/copilot-for-eclipse (README) -->
        <repository>
            <id>github-copilot</id>
            <layout>p2</layout>
            <url>https://azuredownloads-g3ahgwb5b8bkbxhd.b01.azurefd.net/github-copilot/</url>
        </repository>
    </repositories>
    <!--
      WHAT TO TEST: one switch, -Drun=<name> (28 Nov, docs/local-commands.md, docs/test-plan.md). Each name says what is
      tested, the kind of test, and which Eclipse it needs:
        -without-eclipse         no Eclipse at all
        -with-temporary-eclipse  Maven makes a fresh Eclipse for the run and throws it away; yours is not touched
        -with-test-eclipse       your test Eclipse (dev-e2e/e2e.properties): closed, given the new build, restarted

        mvn verify                                                       all unit tests (as before)
        mvn verify -Drun=all-unit-tests-without-eclipse                  the same, by name
        mvn verify -Drun=report-unit-tests-without-eclipse               only the report module's unit tests
        mvn verify -Drun=mcp-server-unit-tests-without-eclipse           only the MCP server's
        mvn verify -Drun=eclipse-plugin-unit-tests-without-eclipse       only the plugin's
        mvn verify -Drun=claude-grader-unit-tests-without-eclipse        only the Claude trial grader's (module testing)
        mvn verify -Drun=claude-code-registration-check-without-eclipse  Claude Code's eclipse-debugger entry is fine
        mvn verify -Drun=eclipse-plugin-ui-tests-with-temporary-eclipse  SWTBot UI tests
        mvn verify -Drun=eclipse-plugin-debugger-tests-with-test-eclipse [-Dit.test=FullSuite|BreakpointTests|...]
        mvn verify -Drun=eclipse-plugin-install-tests-with-test-eclipse  zip install, uninstall, reinstall + RegressionSuite
        mvn verify -Drun=claude-agent-trial-with-test-eclipse            [-Dit.test=ClaudeAgentEndToEndTests#...]
      One class of unit tests: add -Dtest=ClaudeRegistrationTest -Dsurefire.failIfNoSpecifiedTests=false.

      How: every module skips its unit tests when "run" is set (profile run-set), except the module(s) the name asks for;
      the testing module runs the steps of the -with-test-eclipse names (testing/pom.xml); the steps Maven has no
      plugin for are dev-e2e/TestSteps.java and dev-e2e/DevE2E.java, run through the exec plugin.
      report, mcp-server and testing have no parent, so each of them has the same run profiles in its own pom.
    -->
    <profiles>
        <profile>
            <id>run-set</id>
            <activation><property><name>run</name></property></activation>
            <properties><skipTests>true</skipTests></properties>
        </profile>
        <profile>
            <id>run-eclipse-plugin-unit-tests</id>
            <activation><property><name>run</name><value>eclipse-plugin-unit-tests-without-eclipse</value></property></activation>
            <properties><skipTests>false</skipTests></properties>
        </profile>
        <profile>
            <id>run-all-unit-tests</id>
            <activation><property><name>run</name><value>all-unit-tests-without-eclipse</value></property></activation>
            <properties><skipTests>false</skipTests></properties>
        </profile>
        <profile>
            <id>run-claude-code-registration-check</id>
            <activation><property><name>run</name><value>claude-code-registration-check-without-eclipse</value></property></activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>claude-code-registration</id>
                                <phase>validate</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <workingDirectory>${project.basedir}</workingDirectory>
                                    <arguments>
                                        <argument>dev-e2e/TestSteps.java</argument>
                                        <argument>claude-code-registration</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- OPEN-72: the SWTBot UI tests (module eclipse-plugin-ui-tests). The UI test module sets skipTests=false for
             itself. docs/ui-tests.md. -->
        <profile>
            <id>run-eclipse-plugin-ui-tests</id>
            <activation><property><name>run</name><value>eclipse-plugin-ui-tests-with-temporary-eclipse</value></property></activation>
            <modules>
                <module>eclipse-plugin-ui-tests</module>
            </modules>
            <repositories>
                <repository>
                    <id>swtbot</id>
                    <layout>p2</layout>
                    <url>https://download.eclipse.org/technology/swtbot/releases/latest/</url>
                </repository>
            </repositories>
        </profile>
    </profiles>
    <build>
        <plugins>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-maven-plugin</artifactId>
                <version>${tycho.version}</version>
                <extensions>true</extensions>
            </plugin>
        </plugins>
    </build>
</project>
