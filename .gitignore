# Build outputs and editor state
**/bin/
**/target/
**/.settings/
**/.metadata/
*.log

# Runtime-only credentials and private local configuration
bridge.token
.claude.json

# OS metadata
.DS_Store
Thumbs.db

# Embedded MCP artifact generated by Maven
eclipse-plugin/lib/agentic-debugger-mcp.jar
eclipse-plugin/lib/report-format.jar

# Phase 1 local evaluation traces
evaluation/reports/

# Local test-framework installation backups
evaluation/skill-automation/*-backup-*/

# Temporary installer backups
evaluation/skill-automation/*-install-backup-*/

# Java E2E paths/settings are specific to each developer machine
/dev-e2e/e2e.properties

# Captured single-run Eclipse diagnostics should stay outside version control
/eclipse-bridge-threads.txt
/eclipse-errors.txt
