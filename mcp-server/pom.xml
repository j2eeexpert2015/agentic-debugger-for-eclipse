<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Project Information -->
    <groupId>org.learningfromexperience</groupId>
    <artifactId>agentic-debugger-mcp</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Agentic Debugger MCP Server for Eclipse IDE</name>

    <!-- Java Configuration -->
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- MCP SDK Version Management -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp-bom</artifactId>
                <version>2.0.1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Dependencies -->
    <dependencies>
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
        </dependency>

        <!--
          Debugging session report and live events (OPEN-30, OPEN-36, ADR-009): the event model, the isolating
          recorder, the HTML report writer, the shared JSON reader. One module without dependencies (OPEN-38 step 4:
          the ChainTest writer and its library were replaced by the Agent Activity page as the report).
        -->
        <dependency>
            <groupId>org.learningfromexperience</groupId>
            <artifactId>agentic-debugger-report</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!--
          OPEN-44: an SLF4J backend that discards the MCP SDK's log lines. Without any backend SLF4J prints
          "No SLF4J providers were found" (three lines) on stderr at every start, and GitHub Copilot shows each stderr
          line as a [warning]. The SDK's logging went nowhere before as well; the version matches the slf4j-api the
          SDK brings (2.0.16, see the shade output).
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>2.0.16</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Unit tests (src/test/java), run by "mvn clean package"; test scope, never shaded into the jar -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.14.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Build Configuration -->
    <build>
        <plugins>

            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
            </plugin>

            <!-- Unit tests: JUnit 5 (JUnit Platform). Only plain unit tests live in this module;
                 integration tests against a live Eclipse run through dev-e2e/DevE2E.java. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>

            <!-- Maven Shade Plugin: Executable JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>

                <executions>
                    <execution>
                        <phase>package</phase>

                        <goals>
                            <goal>shade</goal>
                        </goals>

                        <configuration>

                            <!-- Preserve original POM -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>

                            <!-- Merge required metadata -->
                            <transformers>

                                <!-- Set application entry point -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.learningfromexperience.eclipse.agentdebug.mcp.DebugMcpServer</mainClass>
                                </transformer>

                                <!-- Merge service provider definitions -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>

                            </transformers>

                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
