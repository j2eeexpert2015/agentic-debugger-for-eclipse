<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
      Debugging session report written with ChainTest (OPEN-30, ADR-009).
      Depends on report-model (the event model), report-format (escaping, Markdown, colours) and on ChainTest; report-model knows nothing about this module.
      The MCP server uses this module only at runtime scope and finds it through java.util.ServiceLoader
      (META-INF/services/org.learningfromexperience.agentdebug.report.ReportWriterProvider), by the name "chaintest".
      Only ChainTest's core engine and its static HTML generator are used, never ChainTestListener (TestNG only)
      and never its cloud storage, whose Azure and AWS SDKs are excluded below.
    -->
    <groupId>org.learningfromexperience</groupId>
    <artifactId>agentic-debugger-report-chaintest</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Agentic Debugger Report Writer (ChainTest)</name>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <chaintest.version>1.0.12</chaintest.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.learningfromexperience</groupId>
            <artifactId>agentic-debugger-report-model</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <!-- Escaping, Markdown, colours: shared with the Agent Activity view (OPEN-36) -->
        <dependency>
            <groupId>org.learningfromexperience</groupId>
            <artifactId>agentic-debugger-report-format</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.aventstack</groupId>
            <artifactId>chaintest-core</artifactId>
            <version>${chaintest.version}</version>
            <exclusions>
                <!-- Cloud storage for ChainLP embeds: not used by the static HTML generator -->
                <exclusion><groupId>com.azure</groupId><artifactId>azure-storage-blob</artifactId></exclusion>
                <exclusion><groupId>com.azure</groupId><artifactId>azure-storage-common</artifactId></exclusion>
                <exclusion><groupId>com.azure</groupId><artifactId>azure-identity</artifactId></exclusion>
                <exclusion><groupId>software.amazon.awssdk</groupId><artifactId>s3</artifactId></exclusion>
                <exclusion><groupId>software.amazon.awssdk</groupId><artifactId>apache-client</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.14.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <systemPropertyVariables>
                        <java.awt.headless>true</java.awt.headless>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
