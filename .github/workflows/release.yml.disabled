# DISABLED TEMPLATE: rename to release.yml and commit to enable tag releases.
# Advance Maven, OSGi bundle and feature versions consistently BEFORE tagging.
name: Publish Eclipse update-site ZIP
on:
  push:
    tags: ['v*']
permissions:
  contents: write
jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '25'
          cache: maven
      - name: Package release
        run: mvn -B -ntp clean package
      - name: Validate p2 ZIP
        run: |
          python3 - <<'PY'
          from pathlib import Path
          from zipfile import ZipFile
          files = list(Path('eclipse-update-site/target').glob('*.zip'))
          assert len(files) == 1, f'Expected one update-site ZIP, got {files}'
          with ZipFile(files[0]) as z:
              names = z.namelist()
              assert any('features/' in n for n in names)
              assert any('plugins/' in n for n in names)
          print(files[0])
          PY
      - name: Publish artifact to GitHub Releases
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: gh release create "$GITHUB_REF_NAME" eclipse-update-site/target/*.zip --generate-notes --verify-tag
