# DISABLED TEMPLATE: rename this file to ci.yml and commit to enable CI.
name: Build and validate
on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '25'
          cache: maven
      - name: Build Java, Eclipse plugin and update site
        run: mvn -B -ntp clean verify
      - name: Verify installable update-site ZIP exists
        run: |
          python3 - <<'PY'
          from pathlib import Path
          from zipfile import ZipFile
          files = list(Path('eclipse-update-site/target').glob('*.zip'))
          assert files, 'No installable update-site ZIP found'
          with ZipFile(files[0]) as z:
              names = z.namelist()
              assert any('features/' in x for x in names), 'No features in update site'
              assert any('plugins/' in x for x in names), 'No plugins in update site'
          print('Verified:', files[0])
          PY
      - uses: actions/upload-artifact@v4
        with:
          name: eclipse-update-site
          path: eclipse-update-site/target/*.zip
          if-no-files-found: error
